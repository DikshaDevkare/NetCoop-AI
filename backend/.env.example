# ==============================================================================
# NetCoop AI - Development Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' inside the 'backend' directory for local development:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================================

# Application display name used in OpenAPI docs and metadata
APP_NAME=NetCoop AI Backend

# Application semantic version
APP_VERSION=0.1.0

# Runtime environment (development, staging, production)
APP_ENV=development

# Debug mode flag (true/false) - enables verbose error traces in development
DEBUG=true

# Global URL prefix for API routes
API_PREFIX=/api

# Application logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Frontend origin(s) permitted for client requests (e.g. Vite React default dev port)
ALLOWED_ORIGINS=http://localhost:5173
